{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/travel-plan/schemas/trip-data.schema.json",
  "title": "Lightweight Unified Trip Data",
  "description": "The single editable input for ordinary generation. The bundled file is an uninitialized, Demo-free starter; routeMap is Builder-derived.",
  "type": "object",
  "required": ["schemaVersion", "metadata", "trip", "days", "config", "map"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "2.0-lite" },
    "metadata": {
      "type": "object",
      "required": ["tripId", "title"],
      "properties": {
        "tripId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "description": "Optional IANA time-zone override for Daily Today. When omitted or invalid, the page uses the current browser time zone."
        }
      }
    },
    "trip": {
      "type": "object",
      "required": ["dayCount"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "startDate": { "type": ["string", "null"] },
        "endDate": { "type": ["string", "null"] },
        "dayCount": { "type": "integer", "minimum": 0 },
        "primaryDestinationCountries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/countryCode" }
        }
      }
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["day", "date", "schedule"],
        "properties": {
          "day": { "type": "integer", "minimum": 1 },
          "date": { "$ref": "#/$defs/date" },
          "schedule": { "type": "array" }
        }
      }
    },
    "config": { "$ref": "#/$defs/config" },
    "map": { "$ref": "#/$defs/map" },
    "routeMap": {
      "description": "Generated by scripts/build-map.mjs; ordinary generation does not author this field.",
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "trip": {
            "properties": { "status": { "const": "uninitialized" } },
            "required": ["status"]
          }
        },
        "required": ["trip"]
      },
      "then": {
        "properties": {
          "trip": {
            "properties": {
              "startDate": { "type": "null" },
              "endDate": { "type": "null" },
              "dayCount": { "const": 0 }
            },
            "required": ["startDate", "endDate", "dayCount"]
          },
          "days": { "maxItems": 0 },
          "config": {
            "properties": {
              "modules": {
                "properties": {
                  "flights": { "const": false },
                  "overview": { "const": false },
                  "itinerary": { "const": false },
                  "todo": { "const": false },
                  "driving": { "const": false },
                  "ledger": { "const": false }
                }
              }
            }
          },
          "map": {
            "properties": {
              "places": { "maxItems": 0 },
              "routes": { "maxItems": 0 },
              "dailyRoutes": { "maxItems": 0 }
            }
          }
        },
        "not": { "required": ["routeMap"] }
      },
      "else": {
        "properties": {
          "metadata": {
            "properties": {
              "tripId": { "not": { "const": "unconfigured" } }
            }
          },
          "trip": {
            "properties": {
              "startDate": { "$ref": "#/$defs/date" },
              "endDate": { "$ref": "#/$defs/date" },
              "dayCount": { "type": "integer", "minimum": 1 }
            },
            "required": ["startDate", "endDate", "dayCount"]
          },
          "days": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "config": {
            "properties": {
              "modules": {
                "properties": { "overview": { "const": true } },
                "required": ["overview"]
              }
            },
            "required": ["modules"]
          }
        },
        "required": ["config"]
      },
      "then": {
        "properties": {
          "map": {
            "properties": {
              "places": { "minItems": 1 },
              "routes": { "minItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "config": {
            "properties": {
              "modules": {
                "properties": { "flights": { "const": true } },
                "required": ["flights"]
              }
            },
            "required": ["modules"]
          }
        },
        "required": ["config"]
      },
      "then": {
        "properties": {
          "flights": {
            "type": "array",
            "items": { "$ref": "#/$defs/flightWithUtcOffsets" }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "config": {
            "properties": {
              "modules": {
                "properties": { "driving": { "const": true } },
                "required": ["driving"]
              }
            },
            "required": ["modules"]
          }
        },
        "required": ["config"]
      },
      "then": {
        "required": ["groundTransport"],
        "properties": {
          "groundTransport": {
            "type": "object",
            "required": ["rentalCar"],
            "properties": {
              "rentalCar": { "$ref": "#/$defs/rentalWithUtcOffsets" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "utcOffset": {
      "type": "string",
      "pattern": "^(?:[-](?:(?:0[0-9]|1[01]):[0-5][0-9]|12:00)|[+](?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))$",
      "description": "UTC offset in ±HH:MM form, from -12:00 through +14:00."
    },
    "eventWithUtcOffset": {
      "type": "object",
      "required": ["utcOffset"],
      "properties": {
        "utcOffset": { "$ref": "#/$defs/utcOffset" }
      }
    },
    "flightWithUtcOffsets": {
      "type": "object",
      "properties": {
        "placeholder": { "type": "boolean" }
      },
      "if": {
        "properties": { "placeholder": { "const": true } },
        "required": ["placeholder"]
      },
      "else": {
        "required": ["departure", "arrival"],
        "properties": {
          "departure": { "$ref": "#/$defs/eventWithUtcOffset" },
          "arrival": { "$ref": "#/$defs/eventWithUtcOffset" }
        }
      }
    },
    "rentalWithUtcOffsets": {
      "type": "object",
      "required": ["pickup", "dropoff"],
      "properties": {
        "pickup": { "$ref": "#/$defs/eventWithUtcOffset" },
        "dropoff": { "$ref": "#/$defs/eventWithUtcOffset" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "modules", "persistence"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "language": { "type": "string", "minLength": 2 },
        "modules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flights", "overview", "itinerary", "todo", "driving", "ledger"],
          "properties": {
            "flights": { "type": "boolean" },
            "overview": { "type": "boolean" },
            "itinerary": { "type": "boolean" },
            "todo": { "type": "boolean" },
            "driving": { "type": "boolean" },
            "ledger": { "type": "boolean" }
          }
        },
        "persistence": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["local", "d1"] },
            "apiBase": { "type": "string", "pattern": "^/(?!/)[^\\\\?#]+$" },
            "sharedCollections": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["todos", "tickets", "ledger"] }
            },
            "local": { "type": "object" },
            "d1": { "type": "object" }
          },
          "allOf": [
            {
              "if": { "properties": { "mode": { "const": "d1" } }, "required": ["mode"] },
              "then": { "required": ["sharedCollections"] }
            }
          ]
        }
      }
    },
    "region": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "countryCode": { "$ref": "#/$defs/countryCode" },
        "countryCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/countryCode" }
        }
      }
    },
    "mapPlace": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "countryCode": { "$ref": "#/$defs/countryCode" },
        "mapRegionId": { "type": "string", "minLength": 1 },
        "geo": {
          "type": "object",
          "required": ["lat", "lng"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        }
      }
    },
    "mapRoute": {
      "type": "object",
      "required": ["day", "placeIds"],
      "properties": {
        "day": { "type": "integer", "minimum": 1 },
        "placeIds": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "scheduleItems": { "type": "array" }
      }
    },
    "map": {
      "type": "object",
      "required": ["schemaVersion", "mapMode", "templateId", "places", "routes"],
      "properties": {
        "schemaVersion": { "const": "1.0-lite" },
        "mapMode": { "const": "template-auto" },
        "templateId": { "type": "string", "minLength": 1 },
        "defaultRegionId": { "type": "string", "minLength": 1 },
        "region": { "$ref": "#/$defs/region" },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/region" }
        },
        "places": {
          "type": "array",
          "items": { "$ref": "#/$defs/mapPlace" }
        },
        "routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/mapRoute" }
        },
        "dailyRoutes": {
          "type": "array",
          "items": { "$ref": "#/$defs/mapRoute" }
        }
      }
    }
  }
}
